{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:system-design-state": "playwright test --config=playwright.system-design-state.config.ts",
    "test:e2e:system-design-disabled": "playwright test --config=playwright.system-design-disabled.config.ts",
    "api:generate": "openapi-typescript ../backend/openapi.json -o src/lib/api/types.ts",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:system-design-state && npm run test:e2e && npm run test:e2e:system-design-disabled"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.101.2",
    "dompurify": "^3.4.12",
    "isomorphic-dompurify": "^3.19.0",
    "konva": "^10.3.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.10",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.5",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
