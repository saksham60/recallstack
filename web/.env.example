NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
NEXT_PUBLIC_REALTIME_BASE_URL=https://recallstack-ktuc.onrender.com
SYSTEM_DESIGN_ENABLED=1

# Temporary hackathon judge access
DEMO_ACCESS_ENABLED=0
DEMO_EMAIL=
DEMO_PASSWORD=

# Server-only ReasonAI configuration. Only the API key is required.
NEBIUS_API_KEY=
# Server-only ConTree sandbox configuration; reuses NEBIUS_API_KEY.
CONTREE_PROJECT=
CONTREE_URL=https://api.tokenfactory.nebius.com/sandboxes
# Pin a Python image UUID resolved and verified in the selected ConTree project.
CONTREE_PYTHON_IMAGE=
# Execution rollout remains off until the reviewed database migration is applied.
DSA_EXECUTIONS_ENABLED=0
# Enable only after the reviewed V3 report migration and bounded provider checks.
DSA_CODE_INTELLIGENCE_ENABLED=0
# Use 1 for the first cost-limited live verification; production retries cap at 2.
DSA_CODE_INTELLIGENCE_MAX_ATTEMPTS=2
# Optional comma-separated submission UUID allowlist for dispatch AND claims.
# Use exact pilot IDs before enabling limited live checks; blank allows all.
DSA_CODE_INTELLIGENCE_SUBMISSION_IDS=
# Server-only Supabase service role for private job/lease RPCs; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel cron bearer secret for durable execution/outbox recovery.
CRON_SECRET=
# Server-only LangSmith tracing; set both to send ReasonAI traces to the default project.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# Optional server-only search context for the DSA tutor.
TAVILY_API_KEY=
# REASONAI_MODEL=nvidia/nemotron-3-super-120b-a12b
# REASONAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
# REASONAI_V2_MODE=off # off | dsa | system_design | all
# Optional cross-conversation learner profile. Defaults to off; use dsa for PR6.
# REASONAI_MEMORY_MODE=off
