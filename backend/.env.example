APP_ENV=development
LOG_LEVEL=INFO
PORT=8080
DATABASE_URL="postgresql+psycopg://postgres.jlqawpdsyptfxspyqnsu:URL_ENCODED_DATABASE_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=3
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true
REQUEST_BODY_MAX_BYTES=1048576
CORS_ALLOWED_ORIGINS=*
SYNC_RETENTION_DAYS=30
OTEL_ENABLED=false

# Knowledge API: no discovery/model/storage credentials needed to serve prepared stories.
KNOWLEDGE_ENABLED=false
# Supply a random 32+ character secret, identical across API instances. Rotation resets cursors.
KNOWLEDGE_CURSOR_SECRET=
KNOWLEDGE_FEED_DEFAULT_LIMIT=20
KNOWLEDGE_FEED_MAX_LIMIT=50

# Knowledge job: retention is always seven days; there is no retention override.
KNOWLEDGE_BATCH_SIZE=20
KNOWLEDGE_DISCOVERY_TOPICS=software architecture,distributed systems,AI engineering
KNOWLEDGE_DISCOVERY_CONCURRENCY=2
KNOWLEDGE_ENRICHMENT_CONCURRENCY=4
KNOWLEDGE_MODEL_CONCURRENCY=2
KNOWLEDGE_IMAGE_CONCURRENCY=2
KNOWLEDGE_R2_CONCURRENCY=2
KNOWLEDGE_CLEANUP_BATCH_SIZE=100
KNOWLEDGE_CLEANUP_MAX_BATCHES=10
KNOWLEDGE_PROVIDER_TIMEOUT=45
KNOWLEDGE_PROVIDER_RETRIES=2
KNOWLEDGE_IMAGE_MAX_BYTES=8388608
TAVILY_API_KEY=
NEBIUS_API_KEY=
KNOWLEDGE_MODEL=nvidia/nemotron-3-super-120b-a12b
KNOWLEDGE_MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional override; normally derived from R2_ACCOUNT_ID.
R2_ENDPOINT_URL=
